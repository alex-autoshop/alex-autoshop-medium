# Supabase — für Login/Registrierung & Mitgliederbereich.
# Diese Werte in Vercel unter Settings → Environment Variables eintragen.
# Den "publishable"/anon Key findest du in Supabase unter Project Settings → API.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional — Shopify (sonst werden die Standardwerte aus dem Code genutzt)
# VITE_SHOPIFY_DOMAIN=deinshop.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxx

# ── YouLend (Schnellfinanzierung auf /foerdermittel) ─────────────────────────
# Zugangsdaten gibt es NICHT per Selbstregistrierung. YouLend schaltet sie nach
# Abschluss der Partnervereinbarung frei: partnershipmanagement@youlend.com
# Solange diese Variablen leer sind, nimmt /api/youlend die Anfrage trotzdem an
# und schickt sie nur per E-Mail an Alex — die Seite funktioniert also auch ohne.
YOULEND_CLIENT_ID=
YOULEND_CLIENT_SECRET=
# "staging" (Standard) oder "produktion"
YOULEND_UMGEBUNG=staging
# optional, sonst info@alex-autoshop.de
YOULEND_MELDUNG_AN=
