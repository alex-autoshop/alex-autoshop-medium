# Supabase — für Login/Registrierung & Mitgliederbereich.
# Diese Werte in Vercel unter Settings → Environment Variables eintragen.
# Den "publishable"/anon Key findest du in Supabase unter Project Settings → API.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional — Analyse. Ohne VITE_META_PIXEL_ID (15–16 Ziffern) bleibt der Meta-Pixel aus.
# GA4: diese Variable, sonst die Mess-ID im Code. Beides lädt nur nach „Alle akzeptieren“.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# VITE_META_PIXEL_ID=

# Optional — Shopify (sonst werden die Standardwerte aus dem Code genutzt)
# VITE_SHOPIFY_DOMAIN=deinshop.myshopify.com
# VITE_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxx

# ── YouLend (Schnellfinanzierung auf /foerdermittel) ─────────────────────────
# Zugangsdaten gibt es NICHT per Selbstregistrierung. YouLend schaltet sie nach
# Abschluss der Partnervereinbarung frei: partnershipmanagement@youlend.com
# Solange diese Variablen leer sind, nimmt /api/youlend die Anfrage trotzdem an
# und schickt sie nur per E-Mail an Alex — die Seite funktioniert also auch ohne.
YOULEND_CLIENT_ID=
YOULEND_CLIENT_SECRET=
# "staging" (Standard) oder "produktion"
YOULEND_UMGEBUNG=staging
# optional, sonst info@alex-autoshop.de
YOULEND_MELDUNG_AN=

# ── Zahlungen (Stripe + GoCardless) ──────────────────────────────────────────
# https://alex-autoshop.de leitet per 308 auf https://www.alex-autoshop.de um.
# Stripe und GoCardless folgen bei Webhooks keinem Redirect. Deshalb www.
# Fehlt die Variable, gilt derselbe Default. Steht sie noch auf der Apex-Domain,
# setzt der Server sie auf www um.
# PUBLIC_BASE_URL=https://www.alex-autoshop.de
#
# Vercel Production, Projekt alex-autoshop-medium (Werte nur dort, nie ins Repo):
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET          Signing secret des Live-Endpunkts
#   GOCARDLESS_ACCESS_TOKEN        Live-Token
#   GOCARDLESS_ENVIRONMENT=live
#   GOCARDLESS_WEBHOOK_SECRET
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#
# Webhook-URLs im Live-Dashboard eintragen:
#   Stripe:     https://www.alex-autoshop.de/api/stripe-webhook
#   GoCardless: https://www.alex-autoshop.de/api/gocardless-webhook
#
# Stripe-Events, die /api/stripe-webhook verarbeitet — im Live-Endpunkt
# genau diese abonnieren. invoice.paid braucht die Mindestlaufzeit
# (Höchstbeitrag je bezahltem Monat).
#   checkout.session.completed
#   checkout.session.expired
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.paid
#   invoice.payment_failed
#
# GoCardless-Aktionen, die /api/gocardless-webhook auswertet:
#   billing_requests: fulfilled, cancelled
#   payments: confirmed, paid_out, failed, cancelled, charged_back, late_failure_settled
#   subscriptions: cancelled, finished
#   mandates: cancelled, failed, expired
#
# Fehlt GOCARDLESS_WEBHOOK_SECRET, antwortet der Endpunkt 500
# („GOCARDLESS_WEBHOOK_SECRET fehlt“) und verarbeitet nichts.
# Eine falsche GoCardless-Signatur ist 498. Siehe docs/webhooks.md.
