    { "source": "/teileboerse", "destination": "/index.html" },
    { "source": "/teileboerse/:path*", "destination": "/index.html" },
    { "source": "/teile/:slug", "destination": "/index.html" },
    { "source": "/fahrzeugboerse", "destination": "/index.html" },
    { "source": "/fahrzeugboerse/:path*", "destination": "/index.html" },
    { "source": "/fahrzeugmarkt", "destination": "/index.html" },
    { "source": "/fahrzeugmarkt/:path*", "destination": "/index.html" },
    { "source": "/mieten", "destination": "/index.html" },
    { "source": "/vermieten", "destination": "/index.html" },
    { "source": "/finanzierung", "destination": "/index.html" },
    { "source": "/kreditvermittlung", "destination": "/index.html" },
    { "source": "/foerdermittel", "destination": "/index.html" },
