    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/agb", "destination": "/index.html" },
    { "source": "/versand", "destination": "/index.html" },
    { "source": "/widerruf", "destination": "/index.html" },
    { "source": "/kuendigen", "destination": "/index.html" },
    { "source": "/gefahrstoffe", "destination": "/index.html" },
    { "source": "/intern/gefahrstoffe", "destination": "/index.html" },
    { "source": "/marken/:slug", "destination": "/index.html" }
  ]
