{
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "redirects": [
    { "source": "/produkt/a1-der-wax-schwamm", "destination": "/produkt/a1-speed-polish-dr-wack", "permanent": true },
    { "source": "/product/:slug*", "destination": "/produkt/:slug*", "permanent": true },
    { "source": "/products/:slug*", "destination": "/produkt/:slug*", "permanent": true },
    { "source": "/collections/:slug*", "destination": "/kategorie/:slug*", "permanent": true },
    { "source": "/cart", "destination": "https://shop.alex-autoshop.de/cart", "permanent": true },
    { "source": "/pages/:slug*", "destination": "https://shop.alex-autoshop.de/pages/:slug*", "permanent": true },
    { "source": "/teileportal", "destination": "/teileboerse", "permanent": true },
    { "source": "/teileportal/:path*", "destination": "/teileboerse", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/katalog", "destination": "/api/empfehlung?aa=katalog" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/:path*", "destination": "/index.html" },
    { "source": "/kategorie/:path*", "destination": "/index.html" },
    { "source": "/produkt/:path*", "destination": "/index.html" },
    { "source": "/warenkorb", "destination": "/index.html" },
    { "source": "/mitgliedschaft", "destination": "/index.html" },
    { "source": "/teileboerse", "destination": "/index.html" },
    { "source": "/teileboerse/:path*", "destination": "/index.html" },
    { "source": "/teile/:slug", "destination": "/index.html" },
    { "source": "/fahrzeugboerse", "destination": "/index.html" },
    { "source": "/fahrzeugboerse/:path*", "destination": "/index.html" },
    { "source": "/fahrzeugmarkt", "destination": "/index.html" },
    { "source": "/fahrzeugmarkt/:path*", "destination": "/index.html" },
    { "source": "/mieten", "destination": "/index.html" },
    { "source": "/vermieten", "destination": "/index.html" },
    { "source": "/finanzierung", "destination": "/index.html" },
    { "source": "/kreditvermittlung", "destination": "/index.html" },
    { "source": "/foerdermittel", "destination": "/index.html" },
    { "source": "/merkliste", "destination": "/index.html" },
    { "source": "/laden", "destination": "/index.html" },
    { "source": "/konto", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/agb", "destination": "/index.html" },
    { "source": "/versand", "destination": "/index.html" },
    { "source": "/widerruf", "destination": "/index.html" },
    { "source": "/kuendigen", "destination": "/index.html" },
    { "source": "/gefahrstoffe", "destination": "/index.html" },
    { "source": "/intern/gefahrstoffe", "destination": "/index.html" },
    { "source": "/marken/:slug", "destination": "/index.html" }
  ]
}
